# Singalong Environment Configuration
# Copy this file to .env and fill in your own values

# AI Provider Configuration (required for song enhancement features)
# Supported providers: "deepseek" (default), "openai"
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI Configuration (legacy, used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Per-agent model overrides (optional — leave empty for provider defaults)
# AI_TITLE_GUESSER_MODEL=deepseek-chat
# AI_OFF_VOCAL_DETECTOR_MODEL=deepseek-chat
# AI_ARTIST_RESEARCHER_MODEL=deepseek-chat
# AI_GENRE_CLASSIFIER_MODEL=deepseek-chat
# AI_TAGS_SUGGESTER_MODEL=deepseek-chat
# AI_LANGUAGE_IDENTIFIER_MODEL=deepseek-chat
# AI_LYRICS_RESEARCHER_MODEL=deepseek-chat

# Brave Search API (used for lyrics web search + genre/tag metadata context)
BRAVE_API_KEY=your-brave-search-api-key-here
ENABLE_LYRICS_WEB_SEARCH=true
ENABLE_METADATA_WEB_SEARCH=true

# Admin Credentials (default: admin/password)
SINGALONG_ADMIN_USERNAME=admin
SINGALONG_ADMIN_PASSWORD=password

# JWT Configuration
SINGALONG_JWT_SECRET_KEY=singalong-jwt-secret-change-in-production-make-it-longer-than-32-bytes
SINGALONG_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# HTTP Server Configuration (production only)
SINGALONG_HTTP_PORT=9000

# Base URL guests use to reach this server — shown as the player's QR code / join link.
# Set to your LAN hostname or public domain (e.g. http://thursday.local:8069).
SINGALONG_BASE_URL=http://localhost:9000

# Database Configuration
# DATABASE_URL is set automatically in docker-compose
# For local development without Docker, you can override:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/singalong

# CORS Origins (comma-separated, no spaces)
# Development: http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Production: https://singalong.nicenature.space,http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
